# Canonical site URL (no trailing slash). Used for metadata, Open Graph,
# sitemap, and robots. Override on preview/staging so non-production builds
# don't claim the production canonical URL.
NEXT_PUBLIC_SITE_URL=https://ashbhuiyan.com

# Contact form (Formspree) — create a form at https://formspree.io and paste
# the form ID here to enable the contact form. Leave unset to keep the form
# in its safe "email me directly" fallback mode.
NEXT_PUBLIC_FORMSPREE_ID=
